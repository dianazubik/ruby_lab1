
<%= form_with(model: user) do |form| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger">
      <h5>Помилка під час збереження користувача:</h5>
      <ul class="mb-0">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Ім'я користувача", class: "form-label fw-semibold" %>
    <%= form.text_field :name,
        class: "form-control",
        placeholder: "Введіть ім'я користувача" %>
  </div>

  <div class="mb-3">
    <%= form.label :email, "Електронна пошта", class: "form-label fw-semibold" %>
    <%= form.email_field :email,
        class: "form-control",
        placeholder: "example@gmail.com" %>
  </div>

  <div class="mt-4">
    <%= form.submit(
        user.persisted? ? "Зберегти зміни" : "Створити користувача",
        class: "btn btn-primary"
    ) %>
  </div>
<% end %>
