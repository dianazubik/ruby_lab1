
<% content_for :title, "Профіль користувача" %>

<div class="container py-5">

  <h1 class="mb-4">Особистий кабінет</h1>

  <div class="card shadow-sm border-0 mb-5">
    <div class="card-body p-4">

      <h3 class="mb-3">Інформація про користувача</h3>

      <p>
        <strong>Ім'я:</strong>
        <%= @user.name %>
      </p>

      <p>
        <strong>Електронна пошта:</strong>
        <%= @user.email %>
      </p>

      <p>
        <strong>Роль:</strong>
        <%= @user.role %>
      </p>

      <div class="d-flex gap-2 flex-wrap mt-3">
        <%= link_to "Редагувати профіль",
            edit_user_path(@user), class: "btn btn-warning" %>

        <%= button_to "Видалити користувача",
            @user, method: :delete, class: "btn btn-danger" %>
      </div>

    </div>
  </div>

  <h2 class="mb-4">Мої конференційні виступи</h2>

  <% if @conference_sessions.any? %>

    <div class="row g-4">

      <% @conference_sessions.each do |session| %>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0">

            <% if session.image.attached? %>
              <%= image_tag session.image,
                  class: "card-img-top",
                  style: "height: 200px; object-fit: cover;" %>
            <% end %>

            <div class="card-body">

              <h5 class="card-title"><%= session.title %></h5>

              <p class="card-text">
                <%= truncate(session.description, length: 100) %>
              </p>

              <p class="text-muted small">
                Тематичний трек: <%= session.track %><br>
                День конференції: <%= session.conference_day %>
              </p>

              <div class="d-flex flex-wrap gap-2">

                <%= link_to "Переглянути",
                    conference_session_path(session),
                    class: "btn btn-outline-dark btn-sm" %>

                <%= link_to "Редагувати",
                    edit_conference_session_path(session),
                    class: "btn btn-outline-primary btn-sm" %>

                <%= button_to "Видалити",
                    conference_session_path(session),
                    method: :delete,
                    class: "btn btn-outline-danger btn-sm",
                    form: { data: { turbo_confirm: "Видалити цей виступ?" } } %>

              </div>

            </div>
          </div>
        </div>

      <% end %>

    </div>

  <% else %>

    <div class="alert alert-info">
      Ви ще не створили жодного конференційного виступу.
    </div>

  <% end %>

</div>
