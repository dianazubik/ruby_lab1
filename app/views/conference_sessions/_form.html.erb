
<div class="card shadow-sm border-0">
  <div class="card-body p-4">

    <%= form_with(model: conference_session) do |form| %>

      <% if conference_session.errors.any? %>
        <div class="alert alert-danger">
          <h5>Не вдалося зберегти виступ:</h5>
          <ul class="mb-0">
            <% conference_session.errors.each do |error| %>
              <li><%= error.full_message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <%= form.label :title, "Назва виступу", class: "form-label" %>
        <%= form.text_field :title, class: "form-control",
            placeholder: "Введіть назву виступу" %>
      </div>

      <div class="mb-3">
        <%= form.label :description, "Опис виступу", class: "form-label" %>
        <%= form.text_area :description, rows: 5, class: "form-control",
            placeholder: "Опишіть тему та зміст виступу" %>
      </div>

      <div class="mb-3">
        <%= form.label :track, "Тематичний трек", class: "form-label" %>
        <%= form.text_field :track, class: "form-control",
            placeholder: "Наприклад: Web Development" %>
      </div>

      <div class="mb-3">
        <%= form.label :conference_day, "День конференції", class: "form-label" %>
        <%= form.number_field :conference_day, min: 1, max: 2,
            class: "form-control", placeholder: "1 або 2" %>
      </div>

      <div class="mb-4">
        <%= form.label :image, "Зображення виступу", class: "form-label" %>
        <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp",
            class: "form-control" %>
        <div class="form-text">
          Дозволені формати: JPEG, PNG, WebP. Максимальний розмір — 5 МБ.
        </div>

        <% if conference_session.persisted? && conference_session.image.attached? %>
         <div class="mt-3">
        <p class="mb-2">Поточне зображення:</p>
         <%= image_tag conference_session.image,
        class: "img-thumbnail", style: "max-width: 200px;" %>
         </div>
          <% end %>
       </div>

      <div class="d-grid">
        <%= form.submit "Зберегти виступ", class: "btn btn-dark" %>
      </div>

    <% end %>

  </div>
</div>
