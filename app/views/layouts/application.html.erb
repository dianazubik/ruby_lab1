
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "IT Conference 2026" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="IT Conference 2026">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">

    <!-- Навігаційна панель -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">

        <%= link_to "IT Conference 2026", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">
          <ul class="navbar-nav ms-auto">

            <li class="nav-item">
              <%= link_to "Про проєкт", about_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Дні конференції", root_path(anchor: "days"), class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Тематичні треки", root_path(anchor: "tracks"), class: "nav-link" %>
            </li>
              <% if user_signed_in? %>
            <li class="nav-item">
    <%= link_to "Виступи конференції",
        conference_sessions_path, class: "nav-link" %>
  </li>

  <li class="nav-item">
    <%= link_to "Додати виступ",
        new_conference_session_path, class: "nav-link" %>
  </li>
<% end %> 
            <li class="nav-item">
              <%= link_to "Створити користувача", new_user_path, class: "nav-link" %>
            </li>

            <li class="nav-item">
              <%= link_to "Усі користувачі", users_path, class: "nav-link" %>
            </li>

            <% if user_signed_in? %>

              <li class="nav-item">
                <span class="nav-link text-info">
                  Вітаємо, <%= current_user.name %>!
                </span>
              </li>

              <li class="nav-item">
                <%= link_to "Вийти", destroy_user_session_path,
                    class: "nav-link text-warning",
                    data: { turbo_method: :delete } %>
              </li>

            <% else %>

              <li class="nav-item">
                <%= link_to "Увійти", new_user_session_path, class: "nav-link" %>
              </li>

              <li class="nav-item">
                <%= link_to "Реєстрація", new_user_registration_path,
                    class: "nav-link text-info" %>
              </li>

            <% end %>

            <li class="nav-item">
              <%= link_to "Видалити всіх користувачів",
                  destroy_all_users_path,
                  class: "nav-link text-danger",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Ви впевнені, що хочете видалити всіх користувачів?"
                  } %>
            </li>

          </ul>
        </div>
      </div>
    </nav>

    <!-- Основний вміст сторінки -->
    <main class="flex-grow-1">

      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-4 mt-5">
      <div class="container">

        <h4 class="mb-4">Наші спонсори</h4>

        <div class="d-flex justify-content-center align-items-center gap-4 flex-wrap mb-4">

          <%= image_tag "tech_hub.svg", alt: "TECH HUB", width: 150 %>

          <%= image_tag "dev_space.svg", alt: "DEV SPACE", width: 160 %>

          <%= image_tag "code_lab.svg", alt: "CODE LAB", width: 150 %>

        </div>

        <hr class="border-light">

        <h5>Контакти розробника</h5>

        <p class="mb-2">Розробник: Діана Зубик</p>

        <p class="mb-2">
          Електронна пошта:
          <a href="mailto:dianazubik66@gmail.com" class="text-white">
            dianazubik66@gmail.com
          </a>
        </p>

        <p class="mb-0">
          &copy; 2026 IT Conference. Усі права захищені.
        </p>

      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>
